# cooee's parameters for the shared shell-core release/build scripts (template:
# shell-core's scripts/tooling.env.example). Everything else is derived.
APP_NAME=cooee
TAURI_CRATE_DIR=src-tauri
UPDATER_REPO=lockyc/cooee
CORES="shell:shell-core:src-tauri/Cargo.toml config:config-core:crates/cooee-config/Cargo.toml"
