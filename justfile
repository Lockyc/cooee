# cooee — task runner

# Recipes run in `sh`, which doesn't inherit cargo from an interactive fish/zsh setup.
export PATH := env_var('HOME') + "/.cargo/bin:" + env_var('PATH')

# `default` pipes `just --list` through a small stock-perl filter that clips long recipe
# docs to your terminal width (…) instead of wrapping. Self-contained — no external files;
# falls back to plain `just --list` where perl is absent. Edit the recipes below, not this.
# List available recipes
default:
    @if command -v perl >/dev/null 2>&1; then just --color always --list | perl -CS -Mutf8 -lpe 'BEGIN{($w)=`stty size 2>/dev/null </dev/tty`=~/ (\d+)/; $w||=100; $col=(-t STDOUT && !exists $ENV{NO_COLOR})} s/\e\[[0-9;]*m//g unless $col; (my $v=$_)=~s/\e\[[0-9;]*m//g; if(length($v)>$w){my($o,$n)=("",0); while(length && $n<$w-1){ if($col && s/^(\e\[[0-9;]*m)//){$o.=$1}else{s/^(.)//;$o.=$1;$n++} } $_=$o."…".($col?"\e[0m":"")}'; else just --list; fi

# Run a debug .app against the repo's demo config (camera/mic need a real bundle, so not `cargo run`)
[group("dev")]
run: debug-app
    #!/usr/bin/env bash
    set -euo pipefail
    pkill -x cooee || true
    open -n --env COOEE_CONFIG="{{justfile_directory()}}/examples/config.toml" target/debug/bundle/macos/cooee.app

# Build the debug .app bundle
[group("dev")]
debug-app:
    cd src-tauri && cargo tauri build --debug --bundles app

# Run the workspace tests
[group("check")]
test:
    cargo test --workspace

# Type-check the workspace without producing binaries
[group("check")]
check:
    cargo check --workspace

# Format all sources
[group("check")]
fmt:
    cargo fmt --all

# Lint with clippy (warnings as errors)
[group("check")]
clippy:
    cargo clippy --workspace -- -D warnings

# Full pre-merge gate: fmt-check, clippy, active-[patch] guard, tests
[group("check")]
gate:
    cargo fmt --all --check
    cargo clippy --workspace -- -D warnings
    @{{ just_executable() }} _core-patch guard # after clippy, whose build.rs generates core-patch.sh on a fresh clone
    cargo test --workspace

# ── shared-core dev loops (require the sibling ../<core> ghq checkout) ──
# core-patch.sh is generated by build.rs from the pinned shell-core rev (git-ignored), so a fresh
# clone has none until its first build.
[private]
_core-patch +args:
    @[ -f scripts/core-patch.sh ] || { echo "✗ scripts/core-patch.sh is missing — the build generates it; run 'cargo check' first" >&2; exit 1; }
    @bash scripts/core-patch.sh {{args}}

# Build cooee against local ../config-core (uncommitted edits included): activate the [patch]
[group("config")]
config-dev: (_core-patch "dev" "config")

# Re-pin config-core to ../config-core's pushed HEAD + deactivate the patch
[group("config")]
config-pin: (_core-patch "pin" "config")

# Build cooee against local ../shell-core (uncommitted edits included): activate the [patch]
[group("shell")]
shell-dev: (_core-patch "dev" "shell")

# Re-pin shell-core to ../shell-core's pushed HEAD + deactivate the patch
[group("shell")]
shell-pin: (_core-patch "pin" "shell")

# Build the release .app bundle
[group("dist")]
build:
    cd src-tauri && cargo tauri build

# Release: gate → notarized build → tag v<version> → push → GitHub release (see CLAUDE.md)
[group("dist")]
release notes="": gate
    bash scripts/release.sh "{{notes}}"

# Build a release .app and install/replace it in /Applications, then relaunch
[group("dist")]
install: build
    #!/usr/bin/env bash
    set -euo pipefail
    bash scripts/install-app.sh "target/release/bundle/macos/cooee.app"
    bash scripts/launch-app.sh
    echo "✓ cooee updated in /Applications"
